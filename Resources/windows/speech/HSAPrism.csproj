    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HSAPrism</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
