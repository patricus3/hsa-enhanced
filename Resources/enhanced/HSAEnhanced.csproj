<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hearthstone Access Enhanced: the whole mod (its core and every screen). Built by rebuild.sh /
       rebuild.ps1 against the game's own assemblies:
         dotnet build -p:GameManaged=<game Managed dir> -p:GameAssembly=<the game's Assembly-CSharp.dll> -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HSAEnhanced</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- compile against the game's own (stripped) class library, so only members the game ships can be used -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <NoWarn>$(NoWarn);CS0618;MSB3277;MSB3270</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManaged)\*.dll"
               Exclude="$(GameManaged)\Assembly-CSharp.dll;$(GameManaged)\HSAEnhanced.dll;$(GameManaged)\HSACompat.dll;$(GameManaged)\TolkDotNet.dll"
               Private="false" />
    <Reference Include="$(GameAssembly)" Private="false" />
  </ItemGroup>
  <!-- The SDK still adds mscorlib & co. from the .NET Framework reference pack; compile
       against the game's own assemblies only. -->
  <Target Name="UseOnlyGameAssemblies" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_GameDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(GameManaged)'))))</_GameDir>
      <_GameAsmFull>$([System.IO.Path]::GetFullPath('$(GameAssembly)'))</_GameAsmFull>
    </PropertyGroup>
    <ItemGroup>
      <_NotFromGame Include="@(ReferencePath)" Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_GameDir)')) And '%(FullPath)' != '$(_GameAsmFull)'" />
      <ReferencePath Remove="@(_NotFromGame)" />
      <_GameCopy Include="@(_NotFromGame->'$(_GameDir)%(Filename)%(Extension)')" />
      <ReferencePath Include="@(_GameCopy)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="!Exists('$(_GameDir)/mscorlib.dll')" Text="mscorlib.dll not found in $(_GameDir)" />
  </Target>
</Project>
